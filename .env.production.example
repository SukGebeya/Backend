# =============================================================================
# Production Environment Configuration
# =============================================================================
# Copy this file to .env for production deployment
# IMPORTANT: Never commit this file with real secrets!

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
POSTGRES_DB=app

# Redis
REDIS_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# Server
PORT=8080

# JWT
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Reverse proxies in front of the API (e.g. 1 behind nginx). 0 ignores X-Forwarded-For.
TRUSTED_PROXY_COUNT=1
CORS_ALLOWED_ORIGINS=https://gebeya.example.com

# Blnk (run `make seed-blnk` against the production Blnk once and copy the IDs)
# BLNK_SECRET_KEY is also set as BLNK_SERVER_SECRET_KEY on the Blnk containers.
BLNK_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
BLNK_ETB_LEDGER_ID=
BLNK_ESCROW_BALANCE_ID=
BLNK_REVENUE_BALANCE_ID=
BLNK_PROCESSING_FEE_BALANCE_ID=

# Chapa (live keys; CHAPA_MODE=mock is refused outside development)
CHAPA_MODE=live
CHAPA_SECRET_KEY=CHASECK-CHANGE_ME
CHAPA_WEBHOOK_SECRET=CHANGE_ME_TO_THE_DASHBOARD_SECRET_HASH
CHAPA_CALLBACK_URL=https://api.gebeya.example.com/api/v1/payments/chapa/callback
CHAPA_RETURN_URL=https://gebeya.example.com/payment/complete

# Platform
PLATFORM_FEE_PERCENT=5
ORDER_PAYMENT_TIMEOUT=1h
AUTO_CONFIRM_DELIVERY_DAYS=7
PAYOUT_MIN_CENTS=10000
PAYOUT_DAILY_LIMIT_CENTS=10000000
REQUIRE_PHONE_VERIFICATION=true

# SMS (AfroMessage). The sender name must be approved by AfroMessage before launch.
SMS_PROVIDER=afromessage
AFROMESSAGE_TOKEN=CHANGE_ME
AFROMESSAGE_SENDER=Gebeya
AFROMESSAGE_IDENTIFIER_ID=
OTP_SECRET=CHANGE_ME_TO_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARS
