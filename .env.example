# =============================================================================
# Development Environment Configuration
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env

# Server
PORT=8080
ENVIRONMENT=development

# Database (for local development with docker-compose-dev.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable

# Redis (for local development with docker-compose-dev.yml)
REDIS_URL=localhost:6379

# JWT Configuration
JWT_ACCESS_PRIVATE_KEY_PATH=keys/access_private.pem
JWT_ACCESS_PUBLIC_KEY_PATH=keys/access_public.pem
JWT_REFRESH_PRIVATE_KEY_PATH=keys/refresh_private.pem
JWT_REFRESH_PUBLIC_KEY_PATH=keys/refresh_public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Password Hashing (Argon2id)
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
ARGON2_SALT_LENGTH=16
ARGON2_KEY_LENGTH=32

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# CORS Configuration (comma-separated origins)
# Development: http://localhost:3000,http://localhost:5173
# Production: https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_FORMAT=text
LOG_LEVEL=info

# Number of reverse proxies in front of the API (nginx, load balancer).
# 0 = trust only the socket address; X-Forwarded-For is ignored so clients cannot spoof their IP.
TRUSTED_PROXY_COUNT=0

# Blnk Configuration (Financial Ledger)
# Start Blnk with `make local`, then run `make seed-blnk` and paste the printed IDs here.
BLNK_BASE_URL=http://localhost:5001
# Must match BLNK_SERVER_SECRET_KEY on the Blnk containers (docker-compose-dev.yml defaults to this value).
BLNK_SECRET_KEY=dev-blnk-secret
BLNK_ETB_LEDGER_ID=
BLNK_ESCROW_BALANCE_ID=
BLNK_REVENUE_BALANCE_ID=
BLNK_PROCESSING_FEE_BALANCE_ID=

# Chapa Configuration (Payments)
# CHAPA_MODE=mock simulates Chapa in memory (development only); use live with test keys
# (CHASECK_TEST-...) to hit the Chapa sandbox.
CHAPA_MODE=mock
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_SECRET_KEY=
# Secret hash configured in the Chapa dashboard webhook settings. Webhooks are rejected without it.
CHAPA_WEBHOOK_SECRET=dev-webhook-secret
# Chapa calls this after checkout; it must be reachable from the internet in live mode.
CHAPA_CALLBACK_URL=http://localhost:8080/api/v1/payments/chapa/callback
# Where the buyer's browser is sent after paying (your frontend).
CHAPA_RETURN_URL=http://localhost:3000/payment/complete

# Platform
PLATFORM_FEE_PERCENT=5
# Unpaid orders are cancelled and their stock released after this long.
ORDER_PAYMENT_TIMEOUT=1h
# Shipped orders are confirmed on the buyer's behalf after this many days unless disputed.
AUTO_CONFIRM_DELIVERY_DAYS=7
# Payout limits in santim (100 = 1 ETB): minimum 100 ETB, at most 100,000 ETB per merchant per day.
PAYOUT_MIN_CENTS=10000
PAYOUT_DAILY_LIMIT_CENTS=10000000
APP_TIMEZONE=Africa/Addis_Ababa

# Phone verification (SMS one-time codes). Checkout and opening a shop require a verified phone.
REQUIRE_PHONE_VERIFICATION=true
# log = print SMS to the console (development only); afromessage = send through AfroMessage.
SMS_PROVIDER=log
AFROMESSAGE_TOKEN=
AFROMESSAGE_SENDER=
AFROMESSAGE_IDENTIFIER_ID=
# Shared secret for hashing codes; use a random 32+ character value outside development.
OTP_SECRET=dev-otp-secret
# Development only: every code is this value so scripts can complete verification.
OTP_DEV_CODE=123456

# =============================================================================
# Seeding (Development Only)
# =============================================================================
# After running migrations, seed the database with test data:
#
#   make seed      # Full test data (4 users, 2 merchants, 4 products)
#   make seed-dev  # Minimal data (admin user + 8 categories)
#   make seed-reset # Reset database: down, up, then seed
#
# Test accounts (full seed only):
#   Admin:    admin@sukgebeya.com / Admin123!
#   Buyer:    buyer@test.com / Password123!
#   Merchant: merchant@test.com / Password123!
#   Merchant: merchant2@test.com / Password123!
